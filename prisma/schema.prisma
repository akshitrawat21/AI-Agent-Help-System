// Helpdesk AI — multi-tenant schema.
// Every model except User/Session is org-scoped, so tenant data is separated
// by an `orgId` column rather than by database or schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Set by the platform operator. A suspended tenant's public assistant
  /// stops answering; its staff can still sign in and see why.
  suspended Boolean  @default(false)
  /// Origins allowed to embed this tenant's widget, one per line. Empty means
  /// anywhere — fine for evaluation, and the Install page says so.
  allowedOrigins String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  agentConfig   AgentConfig?
  articles      KnowledgeArticle[]
  conversations Conversation[]
  escalations   Escalation[]
  invites       Invite[]
  liveEvents    LiveEvent[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("slate")
  /// Platform operator. Sits above every tenant: sees them all, can create,
  /// suspend and enter any of them. Not an org role — it's about the product.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  messages    Message[]
  escalations Escalation[] @relation("EscalationAssignee")
}

/// Join table: a user can belong to several organizations with a role in each.
model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("agent") // owner | admin | agent
  /// Heartbeat from an open dashboard. "Team online" in the widget means
  /// someone in this org was seen within the last few minutes.
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  orgId     String? // the org the user is currently viewing
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  role      String    @default("agent")
  token     String    @unique
  createdAt DateTime  @default(now())
  acceptedAt DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

/// Per-org tuning for the assistant: persona, thresholds and model wiring.
model AgentConfig {
  id    String @id @default(cuid())
  orgId String @unique

  agentName      String @default("Aria")
  greeting       String @default("Hi! I'm here to help. What can I do for you today?")
  persona        String @default("You are a friendly, concise customer support assistant. Answer using the knowledge base. Never invent facts.")
  tone           String @default("friendly") // friendly | professional | concise

  /// Answers scoring below this escalate to a human instead of being sent.
  confidenceThreshold Float @default(0.6)
  /// Minutes before an unanswered escalation is auto-marked as missed.
  escalationTimeout   Int   @default(30)
  autoLearn           Boolean @default(true)
  voiceEnabled        Boolean @default(true)
  /// Ask visitors for a name and email before the first message, unless the
  /// host site already passed them in.
  collectVisitorDetails Boolean @default(false)

  provider String  @default("local") // local | anthropic | openai
  model    String  @default("claude-sonnet-5")
  apiKey   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model KnowledgeArticle {
  id       String @id @default(cuid())
  orgId    String
  question String
  answer   String
  category String @default("General")
  /// Set when the article was auto-created from a supervisor's answer.
  source   String @default("manual") // manual | learned
  useCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Conversation {
  id      String  @id @default(cuid())
  orgId   String
  title   String  @default("New conversation")
  channel String  @default("chat") // chat | voice | widget

  /// active  - the assistant is handling it
  /// waiting - escalated, nobody has picked it up yet
  /// live    - a teammate is in the conversation, talking to the visitor
  /// resolved / missed - closed
  status String @default("active")

  visitorName  String?
  visitorEmail String?

  /// Bearer token proving the caller is the visitor who started this thread.
  /// The public endpoints are unauthenticated, so without it anyone holding a
  /// conversation id could read the transcript or append to it.
  ///
  /// Nullable only so the column can be added to an existing database. The
  /// route handler always sets a random value on create, and a row without a
  /// token cannot be resumed — the visitor just starts a new conversation.
  visitorToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages   Message[]
  escalations Escalation[]

  @@index([orgId, status])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  /// visitor | assistant | human | system
  role           String
  content        String
  confidence     Float?
  /// Article ids the answer drew on, JSON-encoded.
  sources        String @default("[]")
  /// True when the assistant could not answer this turn — whether it offered
  /// a suggestion or handed off. Consecutive misses are what tip a
  /// conversation from "try rephrasing" into "get a person".
  missed         Boolean @default(false)
  /// Set for messages written by a teammate rather than the assistant.
  authorId       String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId])
}

model Escalation {
  id             String @id @default(cuid())
  orgId          String
  conversationId String

  question      String
  draftAnswer   String?
  confidence    Float   @default(0)
  /// low_confidence | no_match | visitor_request | visitor_unsatisfied | repeated_miss
  reason        String  @default("low_confidence")
  /// Copied from the conversation so the queue can route a voice hand-off to
  /// a live call and a chat hand-off to chat, without a second lookup.
  channel       String  @default("chat")

  status     String    @default("pending") // pending | answered | missed
  answer     String?
  assigneeId String?
  answeredAt DateTime?
  /// When the escalation flips to "missed" if nobody answers.
  dueAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("EscalationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
}

/// A dashboard live event, kept for a few minutes so pollers on serverless
/// hosts can catch up. Written by lib/events.ts, which also sweeps old rows.
model LiveEvent {
  id             String   @id @default(cuid())
  orgId          String
  type           String
  escalationId   String?
  conversationId String?
  createdAt      DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// One hit against a rate-limited key (e.g. `ip:slug`). lib/rate-limit.ts
/// counts rows in the window and sweeps old ones as it goes.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
