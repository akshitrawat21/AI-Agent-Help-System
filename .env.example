# ---------------------------------------------------------------------------
# Helpdesk AI — environment
# `npm run dev` creates a .env from this file automatically on first run.
# ---------------------------------------------------------------------------

# Postgres connection string.
#
# This default matches `npm run db:up`, which starts a Postgres 17 container
# on port 5433 — chosen so it can't collide with a Postgres already installed
# on the host at 5432.
#
# To use your own server instead, point this at it and create the database
# first (`createdb helpdesk_ai`), e.g.:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk_ai"
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5433/helpdesk_ai"

# ---------------------------------------------------------------------------
# LLM provider (optional)
#
# Leave these blank and the assistant runs on the built-in retrieval engine:
# it answers from your knowledge base and escalates anything it can't ground
# in an article. Add a key to have a hosted model phrase the replies instead.
#
# A key set here is the fallback for every workspace. A workspace can override
# it under Assistant -> Engine, which stores the key against that workspace
# only.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# No session-signing secret is needed. A session is an opaque 256-bit random
# token stored in the database and matched on every request, so there is
# nothing in the cookie to forge — see lib/auth/session.ts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Platform super admin (optional)
#
# Whoever signs up with this email becomes the platform operator: they see
# /admin and can create, suspend, enter and delete every workspace. Set it
# before the first signup on a new deployment. For an account that already
# exists, run `npm run make-super-admin -- you@company.com` instead.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Live updates transport (optional)
#
# The dashboard gets live updates over server-sent events on a long-running
# server, and by polling on serverless hosts. Vercel is detected automatically;
# set this to force one or the other anywhere else. Values: sse | poll
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIVE_TRANSPORT=""
